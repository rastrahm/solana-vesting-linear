  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "ts-mocha": "ts-mocha",
    "build": "anchor build",
    "test": "anchor test",
    "test:app": "npm --prefix app test",
    "build:app": "npm --prefix app run build",
    "test:all": "npm test && npm run test:app",
    "sync:idl": "bash scripts/sync-idl.sh",
    "deploy:localnet": "bash scripts/localnet-deploy.sh",
    "dev:app": "npm --prefix app run dev"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.15"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
